VOICESHIELD_MODEL_PATH=models/lfcc_baseline.joblib
VOICESHIELD_AASIST_MODEL_PATH=models/aasist.onnx
VOICESHIELD_MAX_UPLOAD_MB=20
VOICESHIELD_INCONCLUSIVE_MARGIN=0.25
VOICESHIELD_SCREENING_LABELS_VALIDATED=false
# Required for the opt-in Android speakerphone microphone experiment.
# Configure only when serving the backend over HTTPS/WSS; never expose this token.
VOICESHIELD_CALL_STREAM_TOKEN=
VOICESHIELD_CALL_AUDIO_LABELS_VALIDATED=false
VOICESHIELD_ENABLE_PRIVATE_REPORTS=true
